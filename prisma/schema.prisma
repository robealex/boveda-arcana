generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_POSTGRES_URL")
}

model PricingSettings {
  id                    Int       @id @default(1)
  nearMintPct           Int       @default(100) @map("near_mint_pct")
  lightlyPlayedPct      Int       @default(90) @map("lightly_played_pct")
  moderatelyPlayedPct   Int       @default(70) @map("moderately_played_pct")
  heavilyPlayedPct      Int       @default(50) @map("heavily_played_pct")
  damagedPct            Int       @default(30) @map("damaged_pct")
  customRateEnabled     Boolean   @default(false) @map("custom_rate_enabled")
  customRate            Float?    @map("custom_rate")
  globalDiscountEnabled Boolean   @default(false) @map("global_discount_enabled")
  globalDiscountPct     Int       @default(0) @map("global_discount_pct")
  globalDiscountStart   DateTime? @map("global_discount_start")
  globalDiscountEnd     DateTime? @map("global_discount_end")

  @@map("pricing_settings")
}

model Deck {
  id            Int        @id @default(autoincrement())
  name          String
  description   String?
  coverImg      String?    @map("cover_img")
  coverName     String?    @map("cover_name")
  price         Decimal
  originalPrice Decimal?   @map("original_price")
  active        Boolean    @default(true)
  moxfieldUrl   String?    @map("moxfield_url")
  createdAt     DateTime   @default(now()) @map("created_at")
  cards         DeckCard[]

  @@map("decks")
}

model DeckCard {
  id          Int      @id @default(autoincrement())
  deck        Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  deckId      Int      @map("deck_id")
  name        String
  qty         Int      @default(1)
  img         String?
  colors      String?
  cmc         Int?
  price       Decimal?
  inventoryId Int?     @map("inventory_id")

  @@map("deck_cards")
}

model StockAlert {
  id          Int       @id @default(autoincrement())
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  inventoryId Int       @map("inventory_id")
  email       String
  notified    Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("stock_alerts")
}

model Inventory {
  id            Int      @id @default(autoincrement())
  name          String
  setName       String?  @map("set_name")
  img           String?
  price         Decimal
  originalPrice Decimal? @map("original_price")
  qty           Int      @default(1)
  condition     String?
  stripeLink    String?  @map("stripe_link")
  colors        String?
  rarity        String?
  typeLine      String?  @map("type_line")
  foil          Boolean  @default(false)
  language      String   @default("en")
  scryfallUri   String?  @map("scryfall_uri")
  notes         String?
  views         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  orderItems    OrderItem[]
  priceHistory  PriceSnapshot[]
  stockAlerts   StockAlert[]

  @@map("inventory")
}

model PriceSnapshot {
  id          Int       @id @default(autoincrement())
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  inventoryId Int       @map("inventory_id")
  myPrice     Decimal   @map("my_price")
  refPrice    Decimal?  @map("ref_price")
  recordedAt  DateTime  @default(now()) @map("recorded_at")

  @@map("price_snapshots")
}

model Customer {
  id                Int      @id @default(autoincrement())
  name              String
  email             String   @unique
  phone             String?
  address           String?
  passwordHash      String   @map("password_hash")
  resetToken        String?  @map("reset_token")
  resetTokenExpiry  DateTime? @map("reset_token_expiry")
  createdAt         DateTime @default(now()) @map("created_at")
  orders            Order[]

  @@map("customers")
}

model Order {
  id            Int         @id @default(autoincrement())
  status        String      @default("pending") // pending | confirmed | cancelled
  expiresAt     DateTime    @map("expires_at")
  totalUsd      Decimal     @map("total_usd")
  customerName  String?     @map("customer_name")
  customerPhone String?     @map("customer_phone")
  customerEmail String?     @map("customer_email")
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId    Int?        @map("customer_id")
  ipAddress     String?     @map("ip_address")
  createdAt     DateTime    @default(now()) @map("created_at")
  items         OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          Int        @id @default(autoincrement())
  order       Order      @relation(fields: [orderId], references: [id])
  orderId     Int        @map("order_id")
  inventory   Inventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  inventoryId Int?       @map("inventory_id")
  name        String
  qty         Int
  priceUsd    Decimal    @map("price_usd")

  @@map("order_items")
}
