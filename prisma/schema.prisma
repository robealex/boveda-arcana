generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_POSTGRES_URL")
}

model Inventory {
  id          Int      @id @default(autoincrement())
  name        String
  setName     String?  @map("set_name")
  img         String?
  price       Decimal
  qty         Int      @default(1)
  condition   String?
  stripeLink  String?  @map("stripe_link")
  colors      String?
  rarity      String?
  typeLine    String?  @map("type_line")
  foil        Boolean  @default(false)
  language    String   @default("en")
  scryfallUri String?  @map("scryfall_uri")
  createdAt   DateTime @default(now()) @map("created_at")
  orderItems  OrderItem[]

  @@map("inventory")
}

model Order {
  id           Int         @id @default(autoincrement())
  status       String      @default("pending") // pending | confirmed | cancelled
  expiresAt    DateTime    @map("expires_at")
  totalUsd     Decimal     @map("total_usd")
  customerName String?     @map("customer_name")
  createdAt    DateTime    @default(now()) @map("created_at")
  items        OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          Int        @id @default(autoincrement())
  order       Order      @relation(fields: [orderId], references: [id])
  orderId     Int        @map("order_id")
  inventory   Inventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  inventoryId Int?       @map("inventory_id")
  name        String
  qty         Int
  priceUsd    Decimal    @map("price_usd")

  @@map("order_items")
}
